# Copy to .env and fill in. Every endpoint is an OpenAI-compatible chat-completions API.

# Levels 2-3, decoding and the conversation: any capable chat model. Needs a context window of 16k tokens or more.
REASONER_BASE_URL=https://api.example.com/v1
REASONER_MODEL=your-model-name
REASONER_API_KEY=
# REASONER_MAX_TOKENS=24000      # lower it if the provider allows fewer output tokens
# REASONER_MIN_TOKENS=4096        # floor for reasoning models that spend tokens before answering; 0 for others

# Level 1: the post-trained open-coding model (base model + LoRA adapter served by vLLM).
# Leave OPENCODER_BASE_URL empty to let the general model do level 1 as well.
OPENCODER_BASE_URL=http://127.0.0.1:8000/v1
OPENCODER_MODEL=opencoding
# OPENCODER_BASE_MODEL=base       # served name of the untrained base model, enables side-by-side comparison
# OPENCODER_CONCURRENCY=6
# OPENCODER_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# Optional: a different model for the thick-description decoding step.
# DECODER_BASE_URL=
# DECODER_MODEL=
# DECODER_API_KEY=

# AGENT_LANG=en                   # en | zh : language of concepts, categories and theory
# AGENT_LENS=general              # general | market : decoding lens
# AGENT_TELEMETRY=1               # 0 skips the two self-rating calls (faster; they never affect selection)
# AGENT_TOOL_MODE=native          # native | text : text works with servers that have no tool-call parser
# AGENT_RUNS_DIR=~/.anthro_agent/runs
