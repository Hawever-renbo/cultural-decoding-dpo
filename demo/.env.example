# Demo server configuration. Copy to .env (git-ignored) on the machine that runs the demo.

# ---- where the demo lives
DEMO_HOST=127.0.0.1
DEMO_PORT=8787
# The public https address people open (the tunnel or proxy in front of this server). No trailing slash.
DEMO_PUBLIC_URL=
# Signs session cookies. Generate once:  python3 -c "import secrets; print(secrets.token_hex(32))"
DEMO_SECRET=
# Set to 1 when a tunnel or reverse proxy sits in front, so rate limits see the visitor's address.
DEMO_TRUST_PROXY=1
# Where "request access" on the sign-in page points.
DEMO_REQUEST_ACCESS_URL=https://github.com/Hawever-renbo/cultural-decoding-dpo/issues/new?template=demo-access.yml

# ---- sign-in by emailed code (any SMTP account; a Gmail address with an app password works)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# SMTP_SECURITY=starttls        # or ssl (port 465)
# MAIL_MODE=console             # development only: print codes to the server log instead of mailing them

# ---- sign-in with GitHub (optional): an OAuth app whose callback is <DEMO_PUBLIC_URL>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- limits
# DEMO_MAX_WORDS=1500           # words per run
# DEMO_MAX_TARGETS=90           # statements coded per run
# DEMO_RUNS_PER_DAY=12          # per person
# DEMO_CHATS_PER_DAY=60         # per person
# DEMO_MAX_CONCURRENT=2         # runs at the same time, all visitors together
# DEMO_KEEP_HOURS=24            # how long a run stays on disk

# ---- models (same variables as agent/.env.example)
# Level 1: the post-trained open-coding model, served on this machine by vLLM.
OPENCODER_BASE_URL=http://127.0.0.1:8000/v1
OPENCODER_MODEL=opencoding
OPENCODER_BASE_MODEL=base
# Levels 2-3, decoding and the conversation: any OpenAI-compatible chat model with a 16k+ context.
REASONER_BASE_URL=
REASONER_MODEL=
REASONER_API_KEY=
# Skip the two self-rating calls to make a run faster (they never affect the result).
AGENT_TELEMETRY=0
